{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portable-agent.dev/contracts/messages/message-context.schema.json",
  "title": "Message context",
  "type": "object",
  "additionalProperties": false,
  "required": ["locale", "timeZone"],
  "properties": {
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(UTC|[A-Za-z_]+(?:/[A-Za-z0-9_+-]+)+)$"
    }
  }
}
